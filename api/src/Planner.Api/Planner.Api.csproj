<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Segredos de desenvolvimento ficam em ~/.microsoft/usersecrets/<este id>/, fora do repositório. -->
    <UserSecretsId>055b3c78-1503-425a-aba2-3d8bf94a069b</UserSecretsId>

    <!-- O build grava o contrato da API em api/openapi/planner.json (versionado; o front é gerado a partir dele). -->
    <OpenApiDocumentsDirectory>$(MSBuildProjectDirectory)/../../openapi</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name planner</OpenApiGenerateDocumentsOptions>

    <!-- Comentários /// viram descrições no OpenAPI. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Planner.Application\Planner.Application.csproj" />
    <ProjectReference Include="..\Planner.Infrastructure\Planner.Infrastructure.csproj" />
  </ItemGroup>

</Project>
